<%- include('../partials/header') %>

    <main class="container my-2 flex-grow-1">
        <h1 class="text-center">
        ESTOU NA PÁGINA DE LISTAR LIVROS
        </h1>

        <!-- BOTÃO PARA PÁGINA DE CADASTRO -->
        <a href="/livro/cadastro">
            <button class="btn-solid theme-accent"> + Novo Livro </button>
        </a>

        <!-- TABELA COM OS DADOS DOS USUÁRIOS -->
        <table class=" table mt-5 table-bordered border-danger">
            <thead>
                <tr>
                    <th scope="col"> Id </th>
                    <th scope="col"> Título </th>
                    <th scope="col"> Autor </th>
                    <th scope="col"> Ano Publicado </th>
                    <th scope="col"> Gênero </th>
                    <th scope="col"> Status </th>
                    <th scope="col"> Ações </th>
                </tr>
            </thead>

            <tbody>
                <!-- LAÇO DE REPETIÇÃO PARA INTERAGIR COM A LISTA VINDO DO BACKEND -->
                <% listaLivros.forEach( livro => { %>
                    <!-- listaUsuarios - lista vinda do banco -->
                    <!-- user - cada indice da lista "listaUsuarios" -->
                    <tr>
                        <td> <%= livro.id_livro %> </td>
                        <td> <%= livro.titulo %> </td>
                        <td> <%= livro.autor %> </td>
                        <td> <%= livro.ano_publicacao %> </td>
                        <td> <%= livro.genero %> </td>
                        <td> <%= livro.esta_disponivel %> </td>
                        <!-- BOTÕES DE AÇÕES -->
                        <td class="d-flex justify-content-center gap-6">
                            <!-- BOTÃO DE EDITAR -->
                            <a href="livro/editar/<%= livro.id_livro %>">
                                <button class="btn-solid theme-warning"> 
                                    Editar 
                                </button>
                            </a>
                            <!-- BOTÃO DE EXCLUIR -->
                            <form 
                                action="livro/deletar/<%= livro.id_livro %>" method="post"
                                onsubmit="return confirm('Deseja realmente excluir esse livro?')">
                                <button type="submit" class="btn-solid theme-danger"> Excluir </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </main>

<%- include('../partials/footer') %>